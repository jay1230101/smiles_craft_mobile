{
  "expo": {
    "name": "smilescraft-mobile",
    "slug": "smilescraft-mobile",
    "version": "1.4.8",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon-ios.png",
    "scheme": "smilescraftmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smilescraft.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/brand/icon-android.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.smilescraft.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brand/icon-ios.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/smilecraft-wordmark.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Smiles Craft to access your photos to attach patient files and X-rays.",
          "cameraPermission": "Allow Smiles Craft to use the camera to capture patient files and X-rays."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/brand/icon-android.png",
          "color": "#014CA9",
          "defaultChannel": "appointments"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b74c6f1-2e77-42d2-867a-6ddba954d764"
      }
    }
  }
}
